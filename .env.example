# GHCR image published by .github/workflows/docker-publish.yml
IMAGE=ghcr.io/jeck5001/digitalplat-auto-register:latest

# The NAS must be able to reach this solver endpoint.
TURNSTILE_REMOTE_ENDPOINT=http://192.168.5.35:5072
TURNSTILE_TIMEOUT=120

# Camoufox is the browser that completed the verified registration flow.
BROWSER_ENGINE=camoufox
BROWSER_TIMEOUT=90000
EMAIL_TIMEOUT=300
VERIFICATION_TIMEOUT=300
VERIFICATION_CHECK_INTERVAL=5
LOG_LEVEL=INFO

# Leave proxy disabled unless your solver and NAS deployment require one.
PROXY_ENABLED=false
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# One registration profile per Compose execution. Do not commit real values.
REGISTRATION_USERNAME=
REGISTRATION_FULLNAME=
REGISTRATION_PHONE=
REGISTRATION_ADDRESS_LINE1=
REGISTRATION_CITY=
REGISTRATION_STATE=
REGISTRATION_POSTAL_CODE=
REGISTRATION_COUNTRY=US
REFERRAL_CODE=
